{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "toolset": "v145,host=x64",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "vs2026-x64",
      "inherits": "vs2026-base",
      "displayName": "Visual Studio 2026 / x64 / slnx",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs2026-x64"
    },
    {
      "name": "vs2026-win32",
      "inherits": "vs2026-base",
      "displayName": "Visual Studio 2026 / Win32 / slnx",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out/build/vs2026-win32"
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "win32-debug",
      "configurePreset": "vs2026-win32",
      "configuration": "Debug"
    },
    {
      "name": "win32-release",
      "configurePreset": "vs2026-win32",
      "configuration": "Release"
    }
  ]
}
